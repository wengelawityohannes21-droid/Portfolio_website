generator client {
  provider = "prisma-client-js"
}

// Local: sqlite | Production: switch to postgresql + Supabase DATABASE_URL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  id             String   @id @default(cuid())
  fullName       String
  headline       String
  tagline        String?
  typingPhrases  String   @default("[]") // JSON string[]
  bio            String
  mission        String?
  passion        String?
  careerGoals    String?
  researchInterests String?
  photoUrl       String?
  cvUrl          String?
  email          String
  phone          String?
  location       String?
  linkedinUrl    String?
  githubUrl      String?
  websiteUrl     String?
  twitterUrl     String?
  instagramUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Education {
  id           String   @id @default(cuid())
  institution  String
  degree       String
  field        String?
  imageUrl     String?
  startDate    String?
  endDate      String?
  current      Boolean  @default(false)
  description  String?
  achievements String   @default("[]") // JSON string[]
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id             String   @id @default(cuid())
  title          String
  organization   String
  location       String?
  imageUrl       String?
  startDate      String?
  endDate        String?
  current        Boolean  @default(false)
  description    String?
  responsibilities String @default("[]") // JSON string[]
  achievements   String   @default("[]") // JSON string[]
  sortOrder      Int      @default(0)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Leadership {
  id           String   @id @default(cuid())
  title        String
  organization String
  imageUrl     String?
  startDate    String?
  endDate      String?
  current      Boolean  @default(false)
  description  String?
  achievements String   @default("[]") // JSON string[]
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Research {
  id              String   @id @default(cuid())
  title           String
  abstract        String?
  description     String?
  objective       String?
  authors         String   @default("[]") // JSON string[]
  institution     String?
  status          String   @default("Ongoing") // Ongoing | Completed | Published
  keywords        String   @default("[]") // JSON string[]
  methods         String   @default("[]") // JSON string[]
  publicationLink String?
  pdfUrl          String?
  imageUrl        String?
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  authors   String   @default("[]")
  journal   String?
  year      String?
  doi       String?
  url       String?
  abstract  String?
  pdfUrl    String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  techStack   String   @default("[]") // JSON string[]
  githubUrl   String?
  liveUrl     String?
  thumbnailUrl String?
  gallery     String   @default("[]") // JSON string[]
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  proficiency Int          @default(80) // 0-100
  sortOrder  Int           @default(0)
  published  Boolean       @default(true)
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Certification {
  id           String   @id @default(cuid())
  title        String
  issuer       String?
  issueDate    String?
  credentialUrl String?
  fileUrl      String?
  imageUrl     String?
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Award {
  id          String   @id @default(cuid())
  title       String
  issuer      String?
  date        String?
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Volunteer {
  id           String   @id @default(cuid())
  title        String
  organization String?
  imageUrl     String?
  startDate    String?
  endDate      String?
  current      Boolean  @default(false)
  description  String?
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  content   String
  avatarUrl String?
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @default("")
  coverImage      String?
  categories      String    @default("[]") // JSON string[]
  tags            String    @default("[]") // JSON string[]
  status          String    @default("draft") // draft | published | scheduled
  publishedAt     DateTime?
  scheduledAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  ogImage         String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  alt          String?
  folder       String   @default("general")
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id              String  @id @default(cuid())
  siteName        String  @default("Wengelawit Yohannes")
  siteUrl         String  @default("http://localhost:3000")
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  ogImage         String?
  primaryColor    String  @default("#16A34A")
  accentColor     String  @default("#1F2937")
  backgroundColor String  @default("#F9FAFB")
  darkModeDefault Boolean @default(false)
  analyticsId     String?
  homepageLayout  String  @default("default")
  showBlog        Boolean @default(true)
  showTestimonials Boolean @default(true)
  // JSON map of section keys → boolean (about, education, mission card, etc.)
  visibleSections String  @default("{}")
  resumeUrl       String?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Draft {
  id        String   @id @default(cuid())
  section   String
  itemId    String?
  payload   String   // JSON
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
